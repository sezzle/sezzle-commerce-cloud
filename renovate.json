{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "preview:dockerCompose",
    "preview:dockerVersions"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Disable everything by default",
      "matchPackageNames": [
        "*"
      ],
      "enabled": false
    },
    {
      "description": "Only devDependencies (and the security overrides) are managed",
      "matchDepTypes": [
        "devDependencies",
        "overrides"
      ],
      "enabled": true
    }
  ]
}
